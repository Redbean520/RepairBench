<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 1.7 原版工作台其实没有“工作动画”：小人就是站着（Toils_Recipe.DoRecipeWork 只放特效/音效/进度条）。
       这里用 1.7 的 AnimationDef 给修补中的小人加一个很小的前后晃动，让它看起来在用力干活。
       只动 Root 的角度（Anomaly 的 DevourerDigesting 就是这么用的），不位移、不改贴图，
       durationTicks 内走完一个完整循环并循环播放；Job 结束时会 SetAnimation(null) 清掉。
       想让动作更轻/更重，改 angle 的绝对值即可（单位：度）。 -->
  <AnimationDef>
    <defName>RepairBench_WorkAnimation</defName>
    <durationTicks>40</durationTicks>
    <startOnRandomTick>false</startOnRandomTick>
    <playWhenDowned>false</playWhenDowned>
    <loopMode>Loop</loopMode>
    <keyframeParts>
      <li>
        <key>Root</key>
        <value>
          <workerType>AnimationWorker_Keyframes</workerType>
          <keyframes>
            <li>
              <tick>0</tick>
              <angle>0</angle>
            </li>
            <li>
              <tick>10</tick>
              <angle>-2.4</angle>
            </li>
            <li>
              <tick>20</tick>
              <angle>0</angle>
            </li>
            <li>
              <tick>30</tick>
              <angle>2.4</angle>
            </li>
            <li>
              <tick>40</tick>
              <angle>0</angle>
            </li>
          </keyframes>
        </value>
      </li>
    </keyframeParts>
  </AnimationDef>

</Defs>
