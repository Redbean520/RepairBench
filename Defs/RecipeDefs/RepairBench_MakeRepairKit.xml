<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef>
    <defName>RepairBench_MakeRepairKit</defName>
    <label>make repair kit</label>
    <description>Assemble repair kits from steel and any textile or leather.</description>
    <jobString>Making repair kit.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <workAmount>2400</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <!-- 任意织物或皮革：原版 ThingCategoryDef "Textiles"（布、合纤、魔鬼菌丝、超织物、各类毛料…）
             与 "Leathers"（各类皮革）。两个都显式列出——Leathers 虽然挂在 Textiles 下面，
             这里写全是为了意图清楚，也防止以后换分类时静默失效。 -->
        <filter>
          <categories>
            <li>Textiles</li>
            <li>Leathers</li>
          </categories>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
      <categories>
        <li>Textiles</li>
        <li>Leathers</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <RepairBench_RepairKit>5</RepairBench_RepairKit>
    </products>
    <skillRequirements>
      <Crafting>2</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <displayPriority>0</displayPriority>
    <recipeUsers>
      <li>FueledSmithy</li>
      <li>ElectricSmithy</li>
    </recipeUsers>
    <researchPrerequisite>RepairBench_RepairTech</researchPrerequisite>
  </RecipeDef>

</Defs>
