<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ParentName="BenchBase" is what every vanilla workbench uses. It brings the bench look and
       behaviour: interactionCellIcon=DiningChair (so the spot marker is a chair, not the generic
       circle), the work-speed report comp, workshop room role, minification and terrain needs.
       We deliberately do NOT copy ElectricTailoringBench's power / bills / stuff-category parts:
       this bench is hand-cranked and has no bill tab, it only runs on repair kits. -->
  <ThingDef ParentName="BenchBase">
    <defName>RepairBench_Bench</defName>
    <label>repair bench</label>
    <description>A cluttered workbench of clamps, spare parts and solvent. Damaged gear left here is slowly restored to full condition, consuming repair kits as the work goes on.</description>
    <thingClass>Building</thingClass>
    <!-- BuildingBase（以及 BenchBase）的默认 drawerType 是 MapMeshOnly，那种建筑永远不跑
         comp 的 PostDraw；原版“没燃料时闪动的缺料图标”正是画在 CompRefuelable.PostDraw 里
         （OverlayDrawer.RenderOutOfFuelOverlay）。改成 MapMeshAndRealTime 才能看到它。
         原版工作台（缝纫台/机械加工台等）也是这个值。 -->
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/RepairBench/RepairBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
      <shaderType>CutoutComplex</shaderType>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
      <!-- 不要在这里写 shadowData：1.7 会报
           "graphicData defines a shadowInfo but staticSunShadowHeight > 0"
           （DefDatabase.ErrorCheckAllDefs）。原版缝纫台同样是 castEdgeShadows + staticSunShadowHeight，
           没有 shadowData。 -->
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <!-- 台体可以用任意金属/木材制作（原版工作台同款 two stuff categories），
         但固定还要 15 钢铁（台钳、丝杠这些承力件）。总造价与原来的 75 钢 + 15 布相当。
         台体贴图是 Graphic_Multi，1.7 的 Graphic_Multi 自带 GetColoredVersion()，
         所以建造时选什么材料，台面就按 stuffProps.color 染色（钢=灰、木=棕、塑钢=青灰…），
         和原版其它可染色建筑完全同一套机制；再叠一层「涂漆」也支持（见 building/paintable）。 -->
    <defaultStuff>Steel</defaultStuff>
    <costStuffCount>75</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costList>
      <Steel>15</Steel>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <WorkToBuild>2400</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>Production</designationCategory>
    <uiOrder>2510</uiOrder>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <building>
      <paintable>true</paintable>
    </building>
    <comps>
      <li Class="CompProperties_Refuelable">
        <!-- 自定义 comp：保留原版装料逻辑，另外在检视面板加一句红字缺料提示。 -->
        <compClass>RepairBench.CompRepairBench</compClass>
        <!-- 选中台就能看到燃料条（= 修补剂余量），不必先打开检视面板。 -->
        <showFuelGizmo>true</showFuelGizmo>
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <fuelCapacity>20</fuelCapacity>
        <autoRefuelPercent>0.9</autoRefuelPercent>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
        <fuelLabel>repair kits</fuelLabel>
        <fuelGizmoLabel>repair kits</fuelGizmoLabel>
        <fuelFilter>
          <thingDefs>
            <li>RepairBench_RepairKit</li>
          </thingDefs>
        </fuelFilter>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>RepairBench_RepairTech</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="RepairBench.RepairBenchExtension">
        <ticksForFullRepair>3000</ticksForFullRepair>
        <kitsForFullRepair>10</kitsForFullRepair>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
