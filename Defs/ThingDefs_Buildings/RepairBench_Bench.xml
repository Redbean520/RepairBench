<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ParentName="BenchBase" is what every vanilla workbench uses. It brings the bench look and
       behaviour: interactionCellIcon=DiningChair (so the spot marker is a chair, not the generic
       circle), the work-speed report comp, workshop room role, minification and terrain needs.
       We deliberately do NOT copy ElectricTailoringBench's power / bills / stuff-category parts:
       this bench is hand-cranked and has no bill tab, it only runs on repair kits. -->
  <ThingDef ParentName="BenchBase">
    <defName>RepairBench_Bench</defName>
    <label>repair bench</label>
    <description>A cluttered workbench of clamps, spare parts and solvent. Damaged gear left here is slowly restored to full condition, consuming repair kits as the work goes on.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/RepairBench/RepairBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
      <shaderType>CutoutComplex</shaderType>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
      <shadowData>
        <volume>(2.8,0.35,0.59)</volume>
        <offset>(0,0,0.08)</offset>
      </shadowData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <costList>
      <Steel>75</Steel>
      <Cloth>15</Cloth>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <WorkToBuild>2400</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>Production</designationCategory>
    <uiOrder>2510</uiOrder>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <building>
      <paintable>true</paintable>
    </building>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <fuelCapacity>20</fuelCapacity>
        <autoRefuelPercent>0.9</autoRefuelPercent>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
        <fuelLabel>repair kits</fuelLabel>
        <fuelGizmoLabel>repair kits</fuelGizmoLabel>
        <fuelFilter>
          <thingDefs>
            <li>RepairBench_RepairKit</li>
          </thingDefs>
        </fuelFilter>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>RepairBench_RepairTech</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="RepairBench.RepairBenchExtension">
        <ticksForFullRepair>3000</ticksForFullRepair>
        <kitsForFullRepair>10</kitsForFullRepair>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
